{
  "manifest_version": 3,
  "name": "Reel Tool Finder",
  "version": "1.0",
  "description": "Auto-scrolls Instagram Reels and sends them to your local Reel Tool Finder.",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.instagram.com/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://www.instagram.com/*"], "js": ["content.js"] }]
}
